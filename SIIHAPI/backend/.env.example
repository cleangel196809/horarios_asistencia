# ════════════════════════════════════════════════════════════════
# SIIHAPI - Entorno de configuración del Backend (Ejemplo)
# Copia este archivo como ".env" y edita los valores
# ════════════════════════════════════════════════════════════════

# ── Django ──
DJANGO_DEBUG=True
# Genera una clave segura para Django
DJANGO_SECRET_KEY=tu_django_secret_key_aqui
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Oracle XE (Esquema SIIHAPI) ──
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=SIIHAPI
ORACLE_PASSWORD=tu_contraseña_oracle_siihapi

# ── Integración SISCA ──
SISCA_API_URL=http://localhost:8080
# Debe coincidir exactamente con el SISCA_API_TOKEN configurado en SISCA
SISCA_API_TOKEN=genera_un_token_sha256_compartido_aqui

# ── JWT (Tokens de Autenticación) ──
# Genera otra clave segura para la firma de JWTs
JWT_SECRET_KEY=tu_jwt_secret_key_aqui

# ── Motor IA - LLM Providers ──
# Si no configuras estas claves, el sistema usará el analizador heurístico local sin Internet
# Obtén tu key de Gemini gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Obtén tu key de OpenAI en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_de_openai_aqui
