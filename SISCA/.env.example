# ════════════════════════════════════════════════════════════════
# SISCA - Entorno de configuración (Ejemplo)
# Copia este archivo como ".env" y edita los valores
# ════════════════════════════════════════════════════════════════

# ── PostgreSQL ──
# En Render no hace falta ninguna de estas: el servicio de base de datos
# inyecta DATABASE_URL y eso tiene prioridad sobre todo lo demás.
# DATABASE_URL=postgresql://usuario:clave@host:5432/integracion_pi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=integracion_pi
POSTGRES_USER=sisca_admin
POSTGRES_PASSWORD=tu_contraseña_postgres

# SISCA comparte la base con SIIHAPI pero vive en su propio esquema, para
# que no choquen `usuario` (SISCA) y `usuarios` (SIIHAPI).
SISCA_DB_SCHEMA=sisca

# El servidor de Render corre en UTC. Sin esto, "hoy" (CURRENT_DATE)
# cambiaría a las 7pm hora de Bogotá y los conteos del día saldrían mal.
SISCA_TZ=America/Bogota

# ── Flask ──
# Genera una clave segura, por ejemplo con: python -c "import secrets; print(secrets.token_hex(24))"
FLASK_SECRET_KEY=tu_clave_secreta_aqui
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=8080

# ── Correo (Notificaciones) ──
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=correo_emisor@politecnico.edu.co
MAIL_PASSWORD=contraseña_de_aplicacion_correo

# ── Sesión y Expiraciones ──
SESSION_LIFETIME_MINUTES=30
QR_EXPIRY_MINUTES=10

# ── Datos de la Institución ──
INSTITUCION_NOMBRE=Politecnico Internacional
INSTITUCION_SNIES=4727

# ── Integración SIIHAPI ──
# Token compartido con el backend de SIIHAPI para firmar e intercomunicar APIs
SISCA_API_TOKEN=genera_un_token_sha256_compartido_aqui
